NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Service Role key de Supabase — Settings > API > service_role. NUNCA se
# expone al navegador (solo se usa en server actions). Necesaria para crear
# cuentas de docentes desde /admin/nuevo-usuario.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Envío de correo (certificado de notas al padre/representante) — resend.com
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM="ARCE <certificados@tudominio.com>"

# Correo que recibe el aviso de nuevas solicitudes de acceso (opcional,
# por defecto usa jorgeriv20770@gmail.com)
ADMIN_EMAIL=jorgeriv20770@gmail.com

# Cuenta que puede entrar a /admin/nuevo-usuario (opcional, por defecto usa
# docente.prueba@profeproyecto.local). Independiente de ADMIN_EMAIL.
ADMIN_LOGIN_EMAIL=docente.prueba@profeproyecto.local
